{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s2-analysis-engine/schema/ruleset-manifest/1",
  "title": "S-RULESET/1",
  "type": "object",
  "required": ["$schema", "schemaVersion", "id", "displayId", "rulesetVersion", "behaviorRevision", "normalizedOptionsHash", "canonicalIdentity", "normalizedOptionsScope", "normalizedOptions", "unresolvedRuleAffectingOptions", "analysisModel", "operationRequirements", "neutralPredicates"],
  "properties": {
    "$schema": { "const": "s2-analysis-engine/schema/ruleset-manifest/1" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "displayId": { "type": "string", "minLength": 1 },
    "rulesetVersion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "behaviorRevision": { "type": "string", "minLength": 1 },
    "normalizedOptionsHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "canonicalIdentity": { "type": "boolean" },
    "normalizedOptionsScope": { "enum": ["all-rule-affecting", "observed-rule-affecting-subset"] },
    "normalizedOptions": { "type": "object" },
    "unresolvedRuleAffectingOptions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "analysisModel": {
      "type": "object",
      "required": ["movementAssumption"],
      "properties": {
        "movementAssumption": {
          "enum": ["unrestricted-within-kickset", "engine-frame-with-hidden-spawn-buffer"]
        }
      },
      "additionalProperties": true
    },
    "operationRequirements": {
      "type": "object",
      "required": ["evaluatePosition", "analyzeBest", "analyzeTopN", "analyzeSequence", "evaluatePlayedMove"],
      "properties": {
        "evaluatePosition": { "$ref": "#/$defs/operationRequirement" },
        "analyzeBest": { "$ref": "#/$defs/operationRequirement" },
        "analyzeTopN": { "$ref": "#/$defs/operationRequirement" },
        "analyzeSequence": { "$ref": "#/$defs/operationRequirement" },
        "evaluatePlayedMove": { "$ref": "#/$defs/operationRequirement" }
      },
      "additionalProperties": false
    },
    "neutralPredicates": {
      "type": "object",
      "additionalProperties": { "enum": ["b2b-inactive", "chain-inactive", "garbage-empty"] }
    }
  },
  "$defs": {
    "mechanism": {
      "enum": ["structured-garbage", "exact-b2b", "b2b-charging", "surge", "cancellation", "chain-state", "time-state", "known-queue", "movement-model", "rule-option"]
    },
    "operationRequirement": {
      "type": "object",
      "required": ["currentStateMechanisms", "reachableMechanisms"],
      "properties": {
        "currentStateMechanisms": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/mechanism" } },
        "reachableMechanisms": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/mechanism" } }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "canonicalIdentity": { "const": true } }, "required": ["canonicalIdentity"] },
      "then": {
        "properties": {
          "id": { "pattern": "^tetrio-s2-v[0-9]+-[0-9a-f]{64}-[a-z0-9-]+$" },
          "normalizedOptionsScope": { "const": "all-rule-affecting" },
          "unresolvedRuleAffectingOptions": { "maxItems": 0 }
        }
      },
      "else": {
        "properties": { "id": { "pattern": "^provisional:" } }
      }
    }
  ],
  "additionalProperties": true
}
